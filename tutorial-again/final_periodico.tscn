theme_override_font_sizes/font_size = 14
text = "Un joven creador de contenido fue internado anoche después de transmitir en vivo una serie de peleas callejeras en la plataforma NeTube.

Según sus seguidores, buscaba hacerse viral a cualquier costo: cada pelea le daba más visitas, y cada rival era más peligroso.

Los médicos aseguran que se recuperará, pero advierten que ninguna cantidad de likes vale poner en riesgo la salud."
autowrap_mode = 3

