[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Texto" type="RichTextLabel" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 486)
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.96, 0.95, 0.92, 1)
theme_override_font_sizes/normal_font_size = 16
theme_override_font_sizes/bold_font_size = 16
bbcode_enabled = true
text = "[center][font_size=26][b]CÓMO SE JUEGA[/b][/font_size][/center]\nTu vida es la [b]BATERÍA[/b] de abajo a la izquierda: cada golpe que recibes la gasta.\n\n[b]CON LA CÁMARA[/b] (de pie, con la cabeza y los hombros a la vista)\n• [b]Defensa:[/b] sube una mano delante de la cara, sobre la barbilla, tapando la nariz. Mantenla mientras te atacan.\n• [b]Esquivar:[/b] inclina el cuerpo a la izquierda o a la derecha [b]justo cuando el rival avisa[/b].\n• [b]Recto:[/b] puñetazo al frente.   • [b]Hook:[/b] gancho lateral, en arco.   (un golpe por gesto: mantenerlo no repite)\n• [b]Uppercut:[/b] puñetazo ascendente, de abajo hacia arriba.   • [b]Patada:[/b] levanta la rodilla o el pie.\n\n[b]CON EL TECLADO[/b]\n• [b]Shift[/b] (mantener) = defender      • [b]A / D[/b] (mantener) = esquivar a la izquierda / derecha\n• [b]P[/b] = Recto   [b]L[/b] = Gancho izq.   [b]Ñ[/b] = Gancho der.   [b]O[/b] = Uppercut   [b]Espacio[/b] = Patada   (una vez por pulsación)\n• [b]ENTER[/b] o clic = continuar en las historias   • [b]H[/b] = abrir / cerrar esta ayuda (en el tutorial)\n\n[b]CÓMO PELEAR[/b]\n• El rival [b]avisa[/b] cada ataque: levanta el guante o la pierna. Defiéndete o esquiva justo entonces.\n• Si lo golpeas [b]justo cuando prepara[/b] el ataque, lo interrumpes y queda mareado (solo cada pocos segundos). Si no, aguanta el golpe y te ataca igual.\n• Si le das 3 golpes seguidos, [b]contraataca[/b] de inmediato: ¡cúbrete o esquiva!\n• [b]PATADAS:[/b] no se pueden bloquear. El rival se gira hacia el lado de la patada: [b]esquiva hacia el lado contrario[/b].\n• [b]ESTAMINA[/b] (barra verde sobre la batería): esquivar y golpear cansan, y quedarte inclinado también. Si se vacía quedas [b]AGOTADO[/b] y no puedes esquivar ni golpear: vuelve al centro para recuperar el aire. Inclinarte antes del aviso [b]no sirve[/b].\n• Si te cubres demasiado, tu guardia se rompe y quedas sin defensa 3 segundos (tus puños se ponen rojizos).\n• Cuando se burla o queda mareado recibe más daño: ¡aprovecha!\n• Mientras peleas suben las visitas del directo, y el chat reacciona a todo."
scroll_active = true

[node name="BotonCerrar" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "Entendido (ENTER)"

[connection signal="pressed" from="Margin/VBox/BotonCerrar" to="." method="_on_cerrar_pressed"]
