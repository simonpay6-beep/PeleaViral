[ext_resource type="Theme" path="res://tema_caricatura.tres" id="98_tema"]

[sub_resource type="StyleBoxFlat" id="sb_ayuda"]
bg_color = Color(0.05, 0.03, 0.03, 0.97)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
